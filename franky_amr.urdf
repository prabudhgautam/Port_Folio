<?xml version="1.0"?>
<robot name="franky_amr">

  <!-- Base Link (Chassis) -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="meshes/base_link.STL"/>
      </geometry>
    </visual>
  </link>

  <!-- Left Wheel -->
  <link name="wheel_left_link">
    <visual>
      <geometry>
        <mesh filename="meshes/wheel_left_link.STL"/>
      </geometry>
    </visual>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0 0.085 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Right Wheel -->
  <link name="wheel_right_link">
    <visual>
      <geometry>
        <mesh filename="meshes/wheel_right_link.STL"/>
      </geometry>
    </visual>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0 -0.085 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Front Caster -->
  <link name="caster_front_link">
    <visual>
      <geometry>
        <mesh filename="meshes/caster_front_link.STL"/>
      </geometry>
    </visual>
  </link>

  <joint name="caster_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_front_link"/>
    <origin xyz="0.10 0 -0.015" rpy="0 0 0"/>
  </joint>

  <!-- Rear Caster -->
  <link name="caster_rear_link">
    <visual>
      <geometry>
        <mesh filename="meshes/caster_rear_link.STL"/>
      </geometry>
    </visual>
  </link>

  <joint name="caster_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_rear_link"/>
    <origin xyz="-0.10 0 -0.015" rpy="0 0 0"/>
  </joint>

  <!-- LiDAR (Laser Link) -->
  <link name="laser_link">
    <visual>
      <geometry>
        <mesh filename="meshes/laser_link.STL"/>
      </geometry>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <!-- IMU Link -->
  <link name="imu_link">
    <visual>
      <geometry>
        <mesh filename="meshes/imu_link.STL"/>
      </geometry>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

</robot>